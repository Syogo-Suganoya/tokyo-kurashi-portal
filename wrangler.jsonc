{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tokyo-kurashi-portal",
  // ハッカソン運営から付与されたアカウント（tokyo_odh_039）。
  // 秘匿情報ではない。**複数のアカウントに所属していると wrangler が非対話でどちらか選べず、
  // `next dev` のバインディング取得が「アカウントを選べない」で失敗する**ため明示しておく。
  "account_id": "a128e75b7210f99f780cccff2c2cf5ab",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-08-17",
  // nodejs_compat は OpenNext が必須とする。
  // global_fetch_strictly_public は、Worker 自身への fetch を公開URL経由に揃えるためのもの
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],

  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },

  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "tokyo-kurashi-portal"
    }
  ],

  // 困りごとチャットの分野判定に使う。**APIキーは要らない**（アカウントに紐づく）
  "ai": {
    "binding": "AI"
  },

  "vars": {
    /*
     * 使うモデル。function calling に対応したものを選ぶこと。
     *
     * 実測で選んだ（本番と同じツール定義・同じ system・10問・3試行）。
     *   qwen3-30b-a3b-fp8            10/10 ・ 約2.3秒  ← これ
     *   deepseek-v4-flash-0731       10/10 ・ 約3.7秒
     *   llama-3.3-70b-instruct（前） 9/10 ・ 約3.4秒
     *   gpt-oss-120b                 10/10 ・ 約6.3秒
     *   llama-4-scout-17b            6/10  ・ 約1.3秒
     *
     * 前のモデルは**3試行とも**「西新宿７丁目」を書き換えた（七丁部・七野・七金目）。
     * qwen3 は書き換えなかった。速さも2/3になる。
     */
    "WORKERS_AI_MODEL": "@cf/qwen/qwen3-30b-a3b-fp8"
  },

  "observability": {
    "enabled": true
  }
}
